# Copy to .env next to docker-compose.yml on the server.

# Cloudflare Tunnel (create with `cloudflared tunnel create <name>`).
TUNNEL_ID=00000000-0000-0000-0000-000000000000
TUNNEL_CREDENTIALS=/home/you/.cloudflared/00000000-0000-0000-0000-000000000000.json
# uid:gid that can read the credentials file (`id -u`, `id -g`).
TUNNEL_UID=1000
TUNNEL_GID=1000

# Optional: an npm mirror for builds (e.g. https://registry.npmmirror.com in mainland China).
NPM_REGISTRY=https://registry.npmjs.org
# Optional: a GitHub token for live contribution data without rate limits.
GITHUB_TOKEN=
